# JWT Gizli Anahtarı (Rust API ile aynı olmalıdır)
JWT_SECRET_KEY=your_secret_key

# Admin (Superuser) Kaydı İçin Gizli Anahtar
SUPER_KEY=super123

# MongoDB Bağlantı Adresi
MONGODB_URI=mongodb://localhost:27017

# Rust API Servisinin Adresi
RUST_API_URL=http://localhost:3030

# Go Web Sunucusu Portu
PORT=8080
