# JWT İmzası için Gizli Anahtar (Rust ve Go aynı anahtarı kullanır)
JWT_SECRET_KEY=your_secret_key

# Yönetici (Superuser) Hesabı Açmak İçin Gizli Anahtar
SUPER_KEY=super123

# MongoDB Bağlantı Adresi
MONGODB_URI=mongodb://localhost:27017

# Rust API Servisinin Adresi (Go Frontend tarafından çağrılır)
RUST_API_URL=http://localhost:3030

# Go Web Sunucusu Portu
PORT=8080
